---
import { getImage } from "astro:assets";
import SpriteViewer from "../components/SpriteViewer.astro";
import Layout from "../layouts/Layout.astro";
import spriteSheet from "../assets/spritesheet-3x3.png";

const sprite = await getImage({
  src: spriteSheet,
  width: 582,
  height: 576,
  format: "webp",
  quality: "max",
});
---

<Layout>
  <link slot="head" rel="preload" as="image" href={sprite.src} fetchpriority="high" />

  <div class="flex h-full flex-col justify-between gap-4 sm:flex-row-reverse sm:items-end sm:gap-12">
    <div class="w-full pt-10 text-left sm:min-w-0 sm:flex-1 sm:pt-0 sm:pb-6 sm:text-right xl:pb-10">
      <h1 class="font-heading mb-4 text-4xl font-normal text-accent">
        Staffan Mowitz
      </h1>
      <div class="text-balance max-w-prose sm:ml-auto sm:text-right">
        <p class="mb-1">Front-end web developer located in Gothenburg, Sweden. Specialized in React, Next.js and Sanity.</p>
        <p>
          Currently at <a class="font-medium text-accent underline" href="https://www.hoy.se/">Hoy</a>.
        </p>
      </div>
    </div>
    <div class="self-end -scale-x-100 sm:scale-x-100">
      <SpriteViewer src={sprite.src} />
    </div>
  </div>
</Layout>
