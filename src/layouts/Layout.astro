---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content="Front-end web developer located in Gothenburg, Sweden." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;500&display=swap"
			rel="stylesheet"
		/>
		<title>Staffan Mowitz - Front-end web developer</title>
	</head>
	<body
		class="flex h-dvh flex-col items-end justify-end bg-page p-6 font-sans font-light text-right text-white sm:p-10"
	>
		<slot />
		<Analytics />
		<SpeedInsights />
	</body>
</html>
